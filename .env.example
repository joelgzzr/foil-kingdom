# Supabase (values from `npx supabase status` locally, or the project's API settings)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose to the browser.
SUPABASE_SECRET_KEY=

# Public site URL used for auth email redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shipping and payments. "mock" is for local development only and is refused in production
# unless ALLOW_MOCK_PROVIDERS=true.
SHIPPING_PROVIDER=mock
PAYMENT_PROVIDER=mock
# Shared secrets used to verify webhook signatures (HMAC-SHA256 of the raw body, hex, in `x-signature`).
SHIPPING_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Secret the scheduler sends as `Authorization: Bearer ...` to /api/cron/* (any long random string).
CRON_SECRET=

# Shown in the privacy notice and terms.
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_CONTACT_EMAIL=

# Binder scanner. "mock" providers are for local development and are refused in production unless ALLOW_MOCK_PROVIDERS=true.
SCAN_VISION_PROVIDER=mock
# Key for the real provider (server only).
GEMINI_API_KEY=
# Optional overrides.
# SCAN_VISION_MODEL=gemini-3.5-flash
# SCAN_DAILY_PAGE_LIMIT=10
# MXN per USD used for price suggestions from TCGplayer reference prices.
USD_MXN_RATE=18
